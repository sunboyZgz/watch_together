# =========================================================
# Global: OS junk, editor temp files, logs
# Applies to the whole monorepo
# =========================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.log


# =========================================================
# Environment files
# Applies to root and module directories
# Keep example files in repo, ignore local-only variants
# Examples:
# - server/.env           -> ignore
# - server/.env.local     -> ignore
# - server/.env.example   -> keep
# - windows/.env.example  -> keep
# =========================================================
.env
.env.*
!.env.example
!.env.*.example


# =========================================================
# Android / Kotlin
# Targets: android/
# Ignore Gradle caches, local machine config, IDE state, builds
# =========================================================
android/.gradle/
android/build/
android/**/build/
android/local.properties
android/.idea/
android/*.iml
android/**/captures/
android/.cxx/


# =========================================================
# Media assets / local transcoding workspace
# Targets: media/
# Keep curated sample assets in repo.
# Do not ignore *.ts globally, because HLS segments use .ts
# while future TypeScript source files may also use .ts.
# =========================================================
media/tmp/
media/out/
media/.cache/
media/raw/
media/**/*.tmp
media/**/*.part


# =========================================================
# Windows client: Tauri + frontend toolchain
# Targets: windows/
# Ignore node deps, frontend build outputs, Rust/Tauri artifacts
# =========================================================
windows/node_modules/
windows/dist/
windows/build/
windows/.parcel-cache/
windows/.vite/
windows/.next/
windows/.nuxt/
windows/coverage/
windows/src-tauri/target/
windows/src-tauri/gen/
windows/src-tauri/Cargo.lock


# =========================================================
# Server / Go
# Targets: server/
# Ignore compiled binaries, test coverage, local work outputs
# =========================================================
server/bin/
server/dist/
server/coverage/
server/.cache/
server/*.test
server/*.out
server/coverage.out


# =========================================================
# Scripts / tooling outputs
# Targets: scripts/
# Ignore ad-hoc generated outputs from local helper scripts
# =========================================================
scripts/.cache/
scripts/tmp/
scripts/out/


# =========================================================
# Generic archives and packaged artifacts
# Applies to the whole monorepo
# =========================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar

### ======== figma .fig
fig/key.txt
postman/
