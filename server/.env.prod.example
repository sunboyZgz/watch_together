# Server runtime
APP_ENV=prod
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info
# Enable temporarily when diagnosing room playback sync in prod-like tests.
DEBUG_SYNC=false

# Database
# Replace username/password/host according to your cloud PostgreSQL deployment.
DATABASE_URL=postgres://watch_together:change_me@127.0.0.1:5432/watch_together_prod?sslmode=disable

# Redis
# Set REDIS_REQUIRED=true only after Redis is deployed and reachable from the server.
REDIS_ADDR=127.0.0.1:6380
REDIS_USERNAME=
REDIS_PASSWORD=change_me
# room_state cache is pinned to DB 0 in code.
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_REQUIRED=false

# Media ingest / storage
# Use the public MinIO endpoint when mediactl runs on your local machine.
# If mediactl runs on the same cloud server, you can switch MEDIA_STORAGE_ENDPOINT to http://127.0.0.1:9100
MEDIA_STORAGE_DRIVER=minio
MEDIA_LOCAL_ROOT=../media/tmp
MEDIA_PUBLIC_BASE_URL=http://xx.xx.xx.xx:9100/watch-together-media
MEDIA_OBJECT_KEY_PREFIX=media

# MinIO / S3-compatible storage
MEDIA_STORAGE_ENDPOINT=http://xx.xx.xx.xx:9100
MEDIA_STORAGE_BUCKET=watch-together-media
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=minioadmin
MEDIA_STORAGE_SECRET_ACCESS_KEY=minioadmin
MEDIA_STORAGE_FORCE_PATH_STYLE=true

# ffmpeg / ffprobe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
