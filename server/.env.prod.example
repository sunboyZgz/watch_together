# Server runtime
APP_ENV=prod
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info
# Set a unique value per roomserver replica, for example roomserver-a.
SERVER_INSTANCE_ID=roomserver-prod-1
# Runtime modes: local_process is the default; distributed_authority requires Redis, NATS, PostgreSQL, Kafka, and a unique SERVER_INSTANCE_ID.
ROOM_RUNTIME_MODE=local_process
# Enable temporarily when diagnosing room playback sync in prod-like tests.
DEBUG_SYNC=false

# Auth
# Change this to a long random secret before deployment.
AUTH_JWT_SECRET=change_me_to_a_long_random_secret
AUTH_ACCESS_TOKEN_TTL_HOURS=24

# Change this to a different long random secret before deployment.
MEDIA_DELIVERY_MODE=nginx_auth_request
MEDIA_PLAYBACK_SIGNING_SECRET=change_me_to_a_different_long_random_secret
MEDIA_PLAYBACK_URL_TTL_SECONDS=7200

# Database
# Standalone binary deployment should set DATABASE_URL directly.
# compose.prod.yaml overrides DATABASE_URL to use the internal postgres service name.
POSTGRES_USER=watch_together
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=watch_together_prod
MEDIA_POSTGRES_DB=watch_together_media_prod
DATABASE_URL=postgres://watch_together:change_me_postgres_password@postgres:5432/watch_together_prod?sslmode=disable
# Optional for standalone binary deployment. compose.prod.yaml sets this for mediaservice.
MEDIA_DATABASE_URL=postgres://watch_together:change_me_postgres_password@postgres:5432/watch_together_media_prod?sslmode=disable

# Redis
# compose.prod.yaml keeps Redis internal and addresses it by service name.
REDIS_ADDR=redis:6380
REDIS_USERNAME=
REDIS_PASSWORD=change_me_redis_password
# room_state cache is pinned to DB 0 in code.
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_REQUIRED=true
# Minimum interval between accepted seek controls in one room. -1 disables.
WS_SEEK_MIN_INTERVAL_MS=250
# Distributed authority hardening. Used only when ROOM_RUNTIME_MODE=distributed_authority.
CONTROL_IDEMPOTENCY_TTL_MS=600000
PRESENCE_LEASE_TTL_MS=45000
PRESENCE_REFRESH_INTERVAL_MS=15000
# Phase 3 cross-instance WebSocket fan-out. Keep disabled until every roomserver has a unique SERVER_INSTANCE_ID.
WS_CROSS_INSTANCE_BROADCAST_ENABLED=false
WS_EVENT_BUS=nats_core
NATS_URL=nats://nats:4222
NATS_NAME=watch-together-roomserver
NATS_SUBJECT_ROOM_BROADCAST=wt.room.broadcast.v1
NATS_SUBJECT_ROOM_CONTROL=wt.room.control.v1

# Kafka timeline and recovery. Required only when ROOM_RUNTIME_MODE=distributed_authority.
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=watch-together-roomserver
KAFKA_TOPIC_ROOM_TIMELINE=wt.room.timeline.v1
KAFKA_TOPIC_ROOM_CONTROL_RESULT=wt.room.control_result.v1
KAFKA_TOPIC_ROOM_MEMBERSHIP=wt.room.membership.v1
KAFKA_DERIVED_CONSUMER_GROUP_ID=watch-together-derived-workers
KAFKA_DERIVED_WORKER_POLL_INTERVAL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_POLL_INTERVAL_MS=1000
AUTHORITY_RENEW_INTERVAL_MS=10000
AUTHORITY_TAKEOVER_SCAN_INTERVAL_MS=30000
AUTHORITY_RECOVERY_TIMEOUT_MS=5000
KAFKA_REPLAY_TIMEOUT_MS=1000

# Observability. Keep /metrics restricted to internal networks at the reverse proxy.
METRICS_ENABLED=true
METRICS_ADDR=
METRICS_PATH=/metrics
READINESS_PATH=/readyz

# Service foundation / internal RPC. Keep local adapters unless the optional services profile is deployed.
SERVICE_NAME=watch-together-roomserver
SERVICE_VERSION=prod
INTERNAL_RPC_ENABLED=false
INTERNAL_RPC_ADDR=:8090
INTERNAL_RPC_PATH_PREFIX=/internal.rpc
INTERNAL_RPC_TIMEOUT_MS=1000
INTERNAL_RPC_AUTH_TOKEN=change_me_internal_rpc_token
SERVICE_DISCOVERY_MODE=static
MEDIA_SERVICE_MODE=local
MEDIA_SERVICE_ADDR=http://mediaservice:8090
TIMELINE_SERVICE_MODE=local
TIMELINE_SERVICE_ADDR=http://timelineservice:8090

# OpenTelemetry tracing. Set the OTLP endpoint to the internal collector when enabled.
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=watch-together-roomserver
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

# Media ingest / storage
MEDIA_STORAGE_DRIVER=minio
MEDIA_LOCAL_ROOT=../media/tmp
MEDIA_PUBLIC_BASE_URL=http://your-domain.example/watch-together-media
MEDIA_INTERNAL_BASE_URL=http://minio:9000/watch-together-media
MEDIA_OBJECT_KEY_PREFIX=media

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MEDIA_STORAGE_ENDPOINT=http://minio:9000
MEDIA_STORAGE_BUCKET=watch-together-media
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=minioadmin
MEDIA_STORAGE_SECRET_ACCESS_KEY=change_me_minio_password
MEDIA_STORAGE_FORCE_PATH_STYLE=true

# Reverse proxy
NGINX_HTTP_PORT=80

# ffmpeg / ffprobe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
