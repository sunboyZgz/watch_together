# Example Nginx config for MEDIA_DELIVERY_MODE=nginx_auth_request.
#
# Goal:
# - Android first requests Go playback entrypoint:
#   /media/playback/{episodeId}/master.m3u8?expires=...&sig=...
# - Go validates the playback URL, sets wt_media_access cookie, then redirects
#   to /watch-together-media/{object-key}.
# - Nginx serves HLS bytes and asks Go /media/internal/auth whether the cookie
#   is allowed for the requested media path.
# - MinIO bucket stays private; Go does not proxy video bytes.
#
# Required server env example:
#   MEDIA_DELIVERY_MODE=nginx_auth_request
#   MEDIA_PUBLIC_BASE_URL=https://watch.example.com/watch-together-media
#   MEDIA_STORAGE_BUCKET=watch-together-media
#
# Replace upstream names/ports with your deployment values.

upstream watch_together_api {
    server 127.0.0.1:8080;
}

upstream watch_together_minio {
    server 127.0.0.1:9100;
}

map $request_uri $media_auth_original_uri {
    ~^/watch-together-media/(.*)$ /$1;
    default $request_uri;
}

server {
    listen 80;
    server_name watch.example.com;

    # In production, terminate HTTPS here or in front of this server.
    # Keep API and media on the same host when possible so wt_media_access
    # cookie is naturally sent to protected HLS requests.

    # 原始 Host 是什么
    # 原始协议是 http 还是 https
    # 客户端真实 IP 是什么
    # 请求经过了哪些代理
    location /auth/ {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /home/ {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /media/playback/ {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /media/items {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /media/tags {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /rooms {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /me/ {
        proxy_pass http://watch_together_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 普通 HTTP 代理不能直接处理 WebSocket 升级，所以必须加：
    # proxy_http_version 1.1;
    # proxy_set_header Upgrade $http_upgrade;
    # proxy_set_header Connection "upgrade";
    location /ws {
        proxy_pass http://watch_together_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # Internal auth endpoint for protected HLS objects.
    # 它不是给客户端直接访问的，因为有：internal;
    location = /media/internal/auth {
        internal;
        proxy_pass http://watch_together_api/media/internal/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $media_auth_original_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # auth_request /media/internal/auth;
    # 也就是先问 Go：这个 Cookie 是否允许访问这个 m3u8？
    # Cache-Control: private, max-age=30(senconds): 意思是 playlist 缓存时间较短，因为 .m3u8 是播放索引文件，不能缓存太久。
    location ~* ^/watch-together-media/.*\.m3u8$ {
        auth_request /media/internal/auth;
        proxy_pass http://watch_together_minio;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "private, max-age=30" always;
    }

    # VOD HLS segments are immutable if object keys are content/version stable.
    location ~* ^/watch-together-media/.*\.(ts|m4s|mp4|vtt|aac)$ {
        auth_request /media/internal/auth;
        proxy_pass http://watch_together_minio;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering on;
        proxy_read_timeout 300s;
        add_header Cache-Control "private, max-age=86400" always;
    }

    # Protected MinIO path-style bucket URL.
    # Example request:
    #   /watch-together-media/media/show/season-01/episode-01/hls/master.m3u8
    location /watch-together-media/ {
        auth_request /media/internal/auth;
        proxy_pass http://watch_together_minio;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering on;
        proxy_read_timeout 300s;
    }
}
