# Server runtime
APP_ENV=local
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=debug
# Optional identifier surfaced in logs and health headers. Leave empty for local binary runs.
SERVER_INSTANCE_ID=
# Runtime modes: local_process is the default; distributed_authority requires Redis, NATS, PostgreSQL, Kafka, and a unique SERVER_INSTANCE_ID.
ROOM_RUNTIME_MODE=local_process

# Optional: allow local desktop/web origin during development
CORS_ALLOWED_ORIGIN=http://127.0.0.1:1420

# Shared runtime values used by the server
MEDIA_BASE_URL=http://127.0.0.1:9000/media/tmp
DEBUG_SYNC=true

# Auth
# Local default is intentionally simple. Override in deployed environments.
AUTH_JWT_SECRET=watch_together_local_dev_jwt_secret_change_me
AUTH_ACCESS_TOKEN_TTL_HOURS=24

# Signed playback entrypoint returned as mediaUrl by REST APIs.
# Local default exists for development; deployed environments must override it.
MEDIA_DELIVERY_MODE=signed_redirect
MEDIA_PLAYBACK_SIGNING_SECRET=watch_together_local_dev_media_playback_secret_change_me
MEDIA_PLAYBACK_URL_TTL_SECONDS=7200

# WebSocket runtime limits
# 0 means unlimited for WS_MAX_CONNECTIONS and ROOM_MAX_CLIENTS.
WS_BROADCAST_CONCURRENCY_LIMIT=64
WS_BROADCAST_TIMEOUT_MS=5000
WS_BROADCAST_ENQUEUE_TIMEOUT_MS=3000
WS_CLIENT_OUTBOX_CAPACITY=64
WS_MAX_CONNECTIONS=0
ROOM_MAX_CLIENTS=0
# Minimum interval between accepted seek controls in one room. -1 disables.
WS_SEEK_MIN_INTERVAL_MS=250
# Phase 3 cross-instance WebSocket fan-out. Disabled by default; uses NATS Core when enabled.
WS_CROSS_INSTANCE_BROADCAST_ENABLED=false
WS_EVENT_BUS=nats_core
NATS_URL=nats://127.0.0.1:4222
NATS_NAME=watch-together-roomserver
NATS_SUBJECT_ROOM_BROADCAST=wt.room.broadcast.v1
NATS_SUBJECT_ROOM_CONTROL=wt.room.control.v1

# Kafka timeline and recovery. Required only when ROOM_RUNTIME_MODE=distributed_authority.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=watch-together-roomserver
KAFKA_TOPIC_ROOM_TIMELINE=wt.room.timeline.v1
KAFKA_TOPIC_ROOM_CONTROL_RESULT=wt.room.control_result.v1
KAFKA_TOPIC_ROOM_MEMBERSHIP=wt.room.membership.v1
KAFKA_DERIVED_CONSUMER_GROUP_ID=watch-together-derived-workers
KAFKA_DERIVED_WORKER_POLL_INTERVAL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_POLL_INTERVAL_MS=1000
AUTHORITY_RENEW_INTERVAL_MS=10000
AUTHORITY_TAKEOVER_SCAN_INTERVAL_MS=30000
AUTHORITY_RECOVERY_TIMEOUT_MS=5000
KAFKA_REPLAY_TIMEOUT_MS=1000

# Database
DATABASE_URL=postgres://app:app@127.0.0.1:5432/anime_watch_dev?sslmode=disable

# Redis
# Optional by default. The local docker compose stack exposes Redis on 127.0.0.1:6380.
REDIS_ADDR=127.0.0.1:6380
REDIS_USERNAME=
REDIS_PASSWORD=watch_together_redis_dev
# room_state cache is pinned to DB 0 in code.
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_REQUIRED=false

# Media ingest / storage
# local is the default development path. minio and s3-compatible upload are also supported.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=../media/tmp
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/media/tmp
MEDIA_INTERNAL_BASE_URL=
MEDIA_OBJECT_KEY_PREFIX=media

# S3-compatible storage settings. Required only when MEDIA_STORAGE_DRIVER=minio or s3.
# Recommended local MinIO ports:
# - API: 9100
# - Console: 9101
MEDIA_STORAGE_ENDPOINT=http://127.0.0.1:9100
MEDIA_STORAGE_BUCKET=watch-together-media
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=minioadmin
MEDIA_STORAGE_SECRET_ACCESS_KEY=minioadmin
MEDIA_STORAGE_FORCE_PATH_STYLE=true

# ffmpeg/ffprobe executables used by mediactl ingest commands.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
